DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Keep enabled for containers. Set to false on serverless platforms after
# applying migrations as part of the release process.
RUN_MIGRATIONS=true

# Optional AI capabilities. The feed, reader, library, and search work without them.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Enable RSS ingestion. On Vercel, vercel.json invokes the secured cron route.
ENABLE_PIPELINE=false

# Keep the process-local scheduler for a long-running container. Disable it on
# serverless hosts, where scheduled requests are handled by the platform.
ENABLE_SCHEDULER=true

# Required by /api/cron/ingest and the manual /api/fetch endpoint.
CRON_SECRET=

# Optional PDF export service.
GOTENBERG_URL=
